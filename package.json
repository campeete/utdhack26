{
  "name": "clean-room",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:server": "tsc --noEmit -p spacetimedb && tsc --noEmit -p spacetimedb/tsconfig.test.json",
    "test": "npm run test:review && npm run test:audit && npm run test:nemotron && npm run test:module",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "test:audit": "tsx --test tests/audit/*.test.ts",
    "demo:chain": "tsx tools/make_demo_chain.ts demo-data/audit_demo_export.json",
    "verify:demo": "python3 tools/verify_audit.py demo-data/audit_demo_export.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.audit.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck:audit": "tsc --noEmit -p tsconfig.audit.json",
    "test:review": "node --experimental-strip-types --test shared/*.test.ts",
    "data:accounts": "python3 tools/export_people_fixture.py demo-data/people.json src/data/northstar-accounts.ts",
    "test:nemotron": "tsx --test server/nemotron/*.test.ts server/intel/*.test.ts server/nora/*.test.ts",
    "nemotron:try": "tsx server/nemotron/try-reassess.ts",
    "intel:fetch": "tsx server/intel/fetch-intel.ts",
    "test:module": "npm --workspace spacetimedb test",
    "nora": "tsx server/nora/run.ts",
    "nora:try": "tsx server/nora/try.ts",
    "demo:setup": "tsx server/demo/setup.ts",
    "module:publish": "spacetime publish -s local --module-path spacetimedb",
    "demo:admit": "tsx server/demo/admit.ts",
    "nora:try-evidence": "tsx server/nora/try-evidence.ts",
    "share": "npx -y cloudflared tunnel --url http://localhost:5173",
    "demo:reset": "tsx server/demo/setup.ts",
    "nora:demo": "NORA_BACKLOG_MAX=0 tsx server/nora/run.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "spacetimedb": "2.14.1",
    "lucide-react": "0.468.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "tailwindcss": "4.1.18",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "26.6.6",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "spacetimedb"
  ]
}
