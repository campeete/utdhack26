# Copy to .env on the machine that runs the Nemotron worker. Never commit .env.
# Get a key at build.nvidia.com. The browser must never see it.
NVIDIA_API_KEY=
# Optional overrides
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_TIMEOUT_MS=60000
NEMOTRON_THINKING=false

# Client (VITE_ prefix = public in the browser bundle; never put secrets here)
VITE_SPACETIME_URI=
VITE_SPACETIME_DB_NAME=

# Nora's watcher (npm run nora) and demo setup (npm run demo:setup)
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DB_NAME=clean-room
# Optional IP lookups; Nora runs without them
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
# How many already-recorded sign-ins Nora analyses at startup
NORA_BACKLOG_MAX=25
